ENV=development
PORT=8001
REDIS_URL=redis://localhost:6379
SIGNALS_STREAM=signals
MARKET_EXCHANGE=binance
SCAN_INTERVAL_SECONDS=60

# Scan et signaux (voir docs/FONCTIONNEMENT.md)
SCANNER_ENABLED=true
UNIVERSE_SIZE=20
# SYMBOLS=BTC,ETH,SOL
SIGNAL_TIMEFRAME=1h
CANDLES_LIMIT=200
CONFIRM_CANDLES=3
EMIT_MIN_SCORE=0.6
EMIT_ON_FIRST_SCAN=false
PUBLISH_HOLD=false
STREAM_MAXLEN=10000
